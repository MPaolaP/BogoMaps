<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BogoMaps.Pages.LoginPage"
             Title="Iniciar sesi&#xF3;n"
             BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16,40,16,24" Spacing="20">

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Border StrokeThickness="0" Padding="0"
                        WidthRequest="96" HeightRequest="96" HorizontalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                    <Image Source="chatgpt_image_14_sept_2026_19_10_24.png" Aspect="AspectFill" />
                </Border>
                <Border BackgroundColor="{StaticResource SurfaceHigh}" StrokeThickness="0"
                        Padding="10,2" HorizontalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="999" /></Border.StrokeShape>
                    <Label Text="COMUNIDAD CAMINANTE" FontSize="11" TextColor="{StaticResource BrandPrimaryDark}"
                           FontFamily="{StaticResource FontLabel}" />
                </Border>
                <Label Text="Bienvenido a BogoMaps" Style="{StaticResource BogoH1}" HorizontalOptions="Center" />
                <Label Text="Tu mapa peatonal de Bogotá: explora, reporta y guarda puntos de interés."
                       Style="{StaticResource BogoBodySm}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource BogoCard}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Modo local" Style="{StaticResource BogoH2}" />
                    <Label Text="Explora Bogotá y guarda tus reportes en este dispositivo. No necesitas cuenta; los datos no se comparten con otros ciudadanos." Style="{StaticResource BogoBody}" />
                    <Entry x:Name="UsuarioEntry" Placeholder="¿Cómo te llamas? (opcional)" MaxLength="60" />
                    <Button Text="Comenzar" Clicked="OnLoginClicked" Style="{StaticResource BogoPrimaryButton}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource SurfaceHigh}" StrokeThickness="0" Padding="14">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnInvitadoTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="Explorar como peat&#xF3;n invitado" Style="{StaticResource BogoLabel}" FontSize="13" />
                        <Label Text="Consulta el mapa sin iniciar sesi&#xF3;n" Style="{StaticResource BogoBodySm}" FontSize="11" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="&#x203A;" FontSize="22" TextColor="{StaticResource Outline}" VerticalOptions="Center" />
                </Grid>
            </Border>



            <Label Text="Tus datos colaborativos impulsan una movilidad peatonal m&#xE1;s segura en Bogot&#xE1;."
                   Style="{StaticResource BogoBodySm}" FontSize="11" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
