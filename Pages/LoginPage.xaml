<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BogoMaps.Pages.LoginPage"
             Title="Iniciar sesión" BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False">
    <ContentPage.Resources>
        <Style x:Key="LoginField" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceLow}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="12" /></Setter.Value></Setter>
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="56,*">
        <Grid Padding="16,4" ColumnDefinitions="44,*,44" BackgroundColor="{StaticResource Surface}">
            <Button Text="←" FontSize="22" CornerRadius="12" BackgroundColor="{StaticResource SurfaceLow}"
                    TextColor="{StaticResource OnSurface}" Clicked="OnBackClicked" SemanticProperties.Description="Explorar como invitado" />
            <HorizontalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                <Border BackgroundColor="{StaticResource BrandPrimary}" StrokeThickness="0" Padding="5,2" StrokeShape="RoundRectangle 7">
                    <Label Text="▥" TextColor="White" FontSize="18" />
                </Border>
                <Label Text="BogoMaps" FontFamily="JakartaBold" FontSize="18" TextColor="{StaticResource OnSurface}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,20,16,24" Spacing="16" MaximumWidthRequest="440" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="8">
                    <Image Source="chatgpt_image_14_sept_2026_19_10_24.png" HeightRequest="88" WidthRequest="88"
                           HorizontalOptions="Center" Aspect="AspectFit" SemanticProperties.Description="Logo de BogoMaps" />
                    <Border BackgroundColor="{StaticResource PrimaryFixed}" StrokeThickness="0" Padding="10,2"
                            HorizontalOptions="Center" StrokeShape="RoundRectangle 999">
                        <Label Text="♿ COMUNIDAD CAMINANTE" FontSize="10" FontFamily="InterSemiBold" TextColor="{StaticResource BrandPrimaryDark}" />
                    </Border>
                    <Label Text="Bienvenido a BogoMaps" FontFamily="JakartaExtraBold" FontSize="24"
                           TextColor="{StaticResource OnSurface}" HorizontalTextAlignment="Center" />
                    <Label Text="Inicia sesión para reportar el estado de las vías, guardar tus rutas peatonales favoritas y cuidar a la comunidad caminante de Bogotá."
                           Style="{StaticResource BogoBodySm}" FontSize="12" LineHeight="1.3" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Border Style="{StaticResource BogoCard}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Correo electrónico o celular" Style="{StaticResource BogoLabel}" FontSize="11" />
                        <Border Style="{StaticResource LoginField}">
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="6">
                                <Label Text="@" TextColor="{StaticResource Outline}" FontSize="22" VerticalOptions="Center" />
                                <Entry Grid.Column="1" x:Name="UsuarioEntry" Placeholder="ejemplo@correo.com" Keyboard="Email"
                                       ReturnType="Next" Completed="OnUsuarioCompleted"
                                       FontFamily="JakartaRegular" FontSize="14" HeightRequest="48"
                                       TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource Outline}"
                                       SemanticProperties.Description="Correo electrónico o celular" />
                            </Grid>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Contraseña" Style="{StaticResource BogoLabel}" FontSize="11" />
                            <Button Grid.Column="1" Text="¿Olvidaste tu contraseña?" Padding="0" MinimumHeightRequest="32"
                                    FontSize="10" BackgroundColor="Transparent" TextColor="{StaticResource BrandPrimary}"
                                    Clicked="OnRecoveryClicked" />
                        </Grid>
                        <Border Style="{StaticResource LoginField}">
                            <Grid ColumnDefinitions="24,*,44" ColumnSpacing="6">
                                <Image Source="login_lock.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                                <Entry Grid.Column="1" x:Name="ClaveEntry" IsPassword="True" Placeholder="••••••••"
                                       FontFamily="JakartaRegular" FontSize="14" HeightRequest="48" ReturnType="Go"
                                       Completed="OnLoginClicked" TextColor="{StaticResource OnSurface}"
                                       PlaceholderColor="{StaticResource Outline}" SemanticProperties.Description="Contraseña" />
                                <Button Grid.Column="2" x:Name="MostrarClaveButton" ImageSource="login_eye.png" Padding="10"
                                        BackgroundColor="Transparent" TextColor="{StaticResource Outline}" Clicked="OnToggleClave"
                                        SemanticProperties.Description="Mostrar contraseña" />
                            </Grid>
                        </Border>
                        <Button Text="Iniciar sesión →" Style="{StaticResource BogoPrimaryButton}" Clicked="OnLoginClicked">
                            <Button.Shadow><Shadow Brush="#2563EB" Offset="0,4" Radius="8" Opacity="0.2" /></Button.Shadow>
                        </Button>
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" Margin="0,4">
                            <BoxView HeightRequest="1" Color="{StaticResource SurfaceContainer}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="o continúa con" Style="{StaticResource BogoBodySm}" FontSize="11" />
                            <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource SurfaceContainer}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Text="Google" ImageSource="google_signin.png" ContentLayout="Left,6" FontFamily="InterMedium" FontSize="12"
                                    BackgroundColor="{StaticResource SurfaceLow}" TextColor="{StaticResource OnSurface}"
                                    CornerRadius="12" HeightRequest="48" Clicked="OnGoogleClicked" SemanticProperties.Description="Continuar con Google" />
                            <Button Grid.Column="1" Text="Apple" FontFamily="InterMedium" FontSize="12"
                                    BackgroundColor="{StaticResource SurfaceLow}" TextColor="{StaticResource OnSurface}"
                                    CornerRadius="12" HeightRequest="48" Clicked="OnAppleClicked" SemanticProperties.Description="Continuar con Apple" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Border BackgroundColor="#EFEDFF" StrokeThickness="0" Padding="14,10" StrokeShape="RoundRectangle 12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnInvitadoTapped" /></Border.GestureRecognizers>
                    <Grid ColumnDefinitions="32,*,20" ColumnSpacing="8">
                        <Border BackgroundColor="#ACF3DF" StrokeThickness="0" StrokeShape="RoundRectangle 8" VerticalOptions="Center" Padding="6">
                            <Image Source="login_compass.png" HeightRequest="18" WidthRequest="18" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Explorar como peatón invitado" Style="{StaticResource BogoLabel}" FontSize="12" />
                            <Label Text="Consulta el mapa sin iniciar sesión" Style="{StaticResource BogoBodySm}" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource Outline}" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="¿No tienes una cuenta?" Style="{StaticResource BogoBodySm}" FontSize="12" VerticalOptions="Center" />
                    <Button Text="Regístrate gratis" Padding="0" MinimumHeightRequest="32" FontSize="12" BackgroundColor="Transparent"
                            TextColor="{StaticResource BrandPrimary}" Clicked="OnRegisterClicked" />
                </HorizontalStackLayout>
                <Border BackgroundColor="{StaticResource SurfaceLow}" StrokeThickness="0" Padding="12,10" StrokeShape="RoundRectangle 12">
                    <Grid ColumnDefinitions="24,*" ColumnSpacing="6">
                        <Image Source="login_shield.png" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Tus datos colaborativos impulsan una movilidad peatonal más segura en Bogotá."
                               Style="{StaticResource BogoBodySm}" FontSize="11" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
