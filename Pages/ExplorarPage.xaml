<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:maps="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BogoMaps.Pages.ExplorarPage"
             Title="Explorar"
             BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="16">

            <!-- Zona del mapa (placeholder hasta integrar el control de mapa) -->
            <Grid HeightRequest="420" BackgroundColor="{StaticResource SurfaceHigh}">
                <maps:MapControl x:Name="CityMap" />
                <VerticalStackLayout Padding="12,12,12,0" Spacing="8" VerticalOptions="Start">
                    <Border Style="{StaticResource BogoCard}" Padding="6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource SurfaceContainer}"
                                    StrokeThickness="0"
                                    WidthRequest="40" HeightRequest="40">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="&#x1F50D;" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Entry x:Name="SearchEntry" TextChanged="OnSearchChanged" Grid.Column="1"
                                   Placeholder="Buscar calle, barrio o punto..."
                                   FontSize="13"
                                   TextColor="{StaticResource OnSurface}"
                                   PlaceholderColor="{StaticResource OnSurfaceVariant}" />
                            <Button Grid.Column="2"
                                    Text="Cerca de mí"
                                    FontSize="11"
                                    CornerRadius="12"
                                    HeightRequest="40"
                                    Padding="12,0"
                                    BackgroundColor="{StaticResource PrimaryFixed}"
                                    TextColor="{StaticResource BrandPrimaryDark}"
                                    Clicked="OnNearMeClicked" />
                        </Grid>
                    </Border>

                    <!-- Chips de filtro -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <Border x:Name="ChipTodos" Style="{StaticResource BogoChip}" BackgroundColor="{StaticResource BrandPrimary}">
                                <Label Text="Todos" Style="{StaticResource BogoLabel}" TextColor="White" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChipTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Border Style="{StaticResource BogoChip}">
                                <Label Text="&#x1F4A1; Iluminación" Style="{StaticResource BogoLabel}" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChipTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Border Style="{StaticResource BogoChip}">
                                <Label Text="&#x267F; Accesibilidad" Style="{StaticResource BogoLabel}" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChipTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Border Style="{StaticResource BogoChip}">
                                <Label Text="&#x26A0; Aceras" Style="{StaticResource BogoLabel}" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChipTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Border Style="{StaticResource BogoChip}">
                                <Label Text="Cruces" Style="{StaticResource BogoLabel}" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChipTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Border Style="{StaticResource BogoChip}"><Label Text="Obras" Style="{StaticResource BogoLabel}" /><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChipTapped" /></Border.GestureRecognizers></Border>
                            <Border Style="{StaticResource BogoChip}"><Label Text="Punto seguro" Style="{StaticResource BogoLabel}" /><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChipTapped" /></Border.GestureRecognizers></Border>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="16,0,16,16" Spacing="16">

                <Label Text="Tus reportes en Bogotá" Style="{StaticResource BogoH2}" />
                <Label Text="Datos de este dispositivo. Rojo: activo; verde: resuelto. No certifican seguridad. El mapa requiere internet. © OpenStreetMap contributors" Style="{StaticResource BogoBodySm}" />
                <VerticalStackLayout x:Name="ReportList" Spacing="12" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
