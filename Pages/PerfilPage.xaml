<?xml version="1.0" encoding="utf-8" ?>
<ui:StitchPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:ui="clr-namespace:BogoMaps.Controls"
 xmlns:maps="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
 x:Class="BogoMaps.Pages.PerfilPage" Title="Perfil">
 <Grid RowDefinitions="62,*,70" BackgroundColor="{StaticResource Surface}">
  <ui:BrandHeader SectionTitle="Perfil" />
  <ScrollView Grid.Row="1">
   <VerticalStackLayout Padding="16" Spacing="22">
    <Border Style="{StaticResource BogoCard}" Padding="24">
     <VerticalStackLayout Spacing="12">
      <Border WidthRequest="92" HeightRequest="92" Stroke="{StaticResource SecondaryContainer}" StrokeThickness="3" StrokeShape="RoundRectangle 46" BackgroundColor="{StaticResource PrimaryFixed}" HorizontalOptions="Center" Padding="0">
       <Grid><Label x:Name="AvatarInitials" FontSize="28" FontFamily="JakartaBold" TextColor="{StaticResource BrandPrimary}" HorizontalOptions="Center" VerticalOptions="Center" /><Image x:Name="AvatarImage" Aspect="AspectFill" IsVisible="False" /></Grid>
      </Border>
      <Label x:Name="NameLabel" Style="{StaticResource BogoH2}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
      <Label Text="Comunidad caminante · Bogotá D.C." Style="{StaticResource BogoBodySm}" FontSize="11" HorizontalTextAlignment="Center" />
      <BoxView WidthRequest="26" HeightRequest="4" Color="{StaticResource SecondaryContainer}" HorizontalOptions="Center" />
      <Label x:Name="BioLabel" Style="{StaticResource BogoBodySm}" HorizontalTextAlignment="Center" Margin="0,4" />
      <Button Text="Editar perfil" Clicked="OnEditClicked" Style="{StaticResource BogoSecondaryButton}" HorizontalOptions="Center" Padding="24,0" />
      <Button Text="Cambiar foto" Clicked="OnAvatarClicked" FontSize="11" BackgroundColor="Transparent" TextColor="{StaticResource BrandPrimary}" HorizontalOptions="Center" />
     </VerticalStackLayout>
    </Border>
    <VerticalStackLayout Spacing="10">
     <Label Text="Impacto ciudadano" Style="{StaticResource BogoH2}" />
     <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <Border Grid.Column="0" Style="{StaticResource BogoCard}"><VerticalStackLayout Spacing="8"><Image Source="ui_flag.png" WidthRequest="26" HeightRequest="26" HorizontalOptions="Start" /><Label x:Name="ReportCount" FontFamily="JakartaBold" FontSize="28" TextColor="{StaticResource OnSurface}" /><Label Text="Reportes creados" Style="{StaticResource BogoBodySm}" FontSize="11" /></VerticalStackLayout></Border>
      <Border Grid.Column="1" Style="{StaticResource BogoCard}"><VerticalStackLayout Spacing="8"><Image Source="ui_check.png" WidthRequest="26" HeightRequest="26" HorizontalOptions="Start" /><Label x:Name="ConfirmationCount" FontFamily="JakartaBold" FontSize="28" TextColor="{StaticResource OnSurface}" /><Label Text="Confirmaciones locales" Style="{StaticResource BogoBodySm}" FontSize="11" /></VerticalStackLayout></Border>
     </Grid>
    </VerticalStackLayout>
    <Border StrokeThickness="0" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource SurfaceContainer}" Padding="4">
     <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3">
      <Button x:Name="TabActivos" Text="Activos" CommandParameter="Activos" Clicked="OnTabClicked" FontSize="11" CornerRadius="12" Padding="4" />
      <Button x:Name="TabResueltos" Grid.Column="1" Text="Resueltos" CommandParameter="Resueltos" Clicked="OnTabClicked" FontSize="11" CornerRadius="12" Padding="4" />
      <Button x:Name="TabGuardados" Grid.Column="2" Text="Guardados" CommandParameter="Guardados" Clicked="OnTabClicked" FontSize="11" CornerRadius="12" Padding="4" />
     </Grid>
    </Border>
    <VerticalStackLayout x:Name="ReportList" Spacing="12" />
    <Label Text="Tus aportes se conservan en este dispositivo y se separan por cuenta." Style="{StaticResource BogoBodySm}" FontSize="11" />
    <Button Text="Cerrar sesión / salir" Clicked="OnCerrarSesionClicked" Style="{StaticResource BogoDangerButton}" />
   </VerticalStackLayout>
  </ScrollView>
  <ui:BottomNavigation Grid.Row="2" ActiveTab="perfil" />
 </Grid>
</ui:StitchPage>
