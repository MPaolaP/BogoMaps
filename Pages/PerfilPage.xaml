<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="BogoMaps.Pages.PerfilPage" Title="Perfil" BackgroundColor="{StaticResource Surface}">
<ScrollView><VerticalStackLayout Padding="16" Spacing="20">
<Border Style="{StaticResource BogoCard}"><VerticalStackLayout Spacing="12"><Label x:Name="NameLabel" Style="{StaticResource BogoH1}" /><Label Text="Perfil local · Bogotá D.C." Style="{StaticResource BogoBodySm}" /><Label x:Name="BioLabel" Style="{StaticResource BogoBody}" /><Button Text="Editar perfil" Clicked="OnEditClicked" Style="{StaticResource BogoSecondaryButton}" /></VerticalStackLayout></Border>
<Label Text="Mi impacto" Style="{StaticResource BogoH2}" /><Label x:Name="CountLabel" Style="{StaticResource BogoBody}" />
<Grid ColumnDefinitions="*,*,*" ColumnSpacing="4"><Button x:Name="TabActivos" Text="Activos" Clicked="OnTabClicked" Style="{StaticResource BogoSecondaryButton}" /><Button x:Name="TabResueltos" Grid.Column="1" Text="Resueltos" Clicked="OnTabClicked" Style="{StaticResource BogoSecondaryButton}" /><Button x:Name="TabGuardados" Grid.Column="2" Text="Guardados" Clicked="OnTabClicked" Style="{StaticResource BogoSecondaryButton}" /></Grid>
<VerticalStackLayout x:Name="ReportList" Spacing="12" />
<Label Text="Tus reportes y tu perfil se guardan solo en este dispositivo. No hay cuenta ni sincronización con otros ciudadanos." Style="{StaticResource BogoBodySm}" />
<Button Text="Salir al inicio" Clicked="OnCerrarSesionClicked" Style="{StaticResource BogoDangerButton}" /></VerticalStackLayout></ScrollView></ContentPage>
