<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="BogoMaps.Pages.DetallePuntoPage" Title="Detalle del punto" BackgroundColor="{StaticResource Surface}">
<ScrollView><VerticalStackLayout Padding="16" Spacing="20">
<Border Style="{StaticResource BogoCard}" BackgroundColor="{StaticResource SurfaceHigh}"><VerticalStackLayout Spacing="12">
<Label x:Name="ReportTitle" Style="{StaticResource BogoH1}" /><Label x:Name="AddressLabel" Style="{StaticResource BogoBody}" /><Label x:Name="StatusLabel" Style="{StaticResource BogoLabel}" />
<Button x:Name="GuardarBtn" Clicked="OnGuardarClicked" Style="{StaticResource BogoSecondaryButton}" /></VerticalStackLayout></Border>
<Image x:Name="PhotoImage" HeightRequest="240" Aspect="AspectFit" IsVisible="False" />
<Label x:Name="DetailsLabel" Style="{StaticResource BogoBodySm}" />
<Border Style="{StaticResource BogoCard}"><VerticalStackLayout Spacing="12"><Label Text="¿Estás en este punto?" Style="{StaticResource BogoH2}" />
<Label Text="La confirmación se conserva en este dispositivo; no acredita seguridad ni verificación comunitaria." Style="{StaticResource BogoBodySm}" />
<Button x:Name="ConfirmarBtn" Text="Confirmar estado" Clicked="OnConfirmarClicked" Style="{StaticResource BogoPrimaryButton}" />
<Button x:Name="ResolvedBtn" Clicked="OnResolvedClicked" Style="{StaticResource BogoSecondaryButton}" />
<Button Text="Abrir indicaciones" Clicked="OnDirectionsClicked" Style="{StaticResource BogoSecondaryButton}" />
<Button Text="Reportar otro punto" Clicked="OnReportarCambioClicked" Style="{StaticResource BogoSecondaryButton}" />
</VerticalStackLayout></Border></VerticalStackLayout></ScrollView></ContentPage>
